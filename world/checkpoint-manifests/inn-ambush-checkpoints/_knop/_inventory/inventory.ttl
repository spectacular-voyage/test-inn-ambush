@base <https://spectacular-voyage.github.io/test-inn-ambush/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .
@prefix sfcfg: <https://semantic-flow.github.io/sflo/config/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<world/checkpoint-manifests/inn-ambush-checkpoints/_knop> a sflo:Knop ;
  sflo:hasKnopMetadata <world/checkpoint-manifests/inn-ambush-checkpoints/_knop/_meta> ;
  sflo:hasKnopInventory <world/checkpoint-manifests/inn-ambush-checkpoints/_knop/_inventory> ;
  sflo:hasWorkingKnopInventoryFile <world/checkpoint-manifests/inn-ambush-checkpoints/_knop/_inventory/inventory.ttl> ;
  sflo:hasPayloadArtifact <world/checkpoint-manifests/inn-ambush-checkpoints> ;
  sflo:hasResourcePage <world/checkpoint-manifests/inn-ambush-checkpoints/_knop/index.html> .

<world/checkpoint-manifests/inn-ambush-checkpoints> a sflo:PayloadArtifact, sflo:DigitalArtifact, sflo:RdfDocument ;
  sflo:nextHistoryOrdinal "2"^^xsd:nonNegativeInteger ;
  sflo:hasWorkingLocatedFile <world/checkpoint-manifests/inn-ambush-checkpoints/checkpoint-manifest.ttl> ;
  sflo:hasResourcePage <world/checkpoint-manifests/inn-ambush-checkpoints/index.html> .

<world/checkpoint-manifests/inn-ambush-checkpoints/_knop/_meta> a sflo:KnopMetadata, sflo:DigitalArtifact, sflo:RdfDocument ;
  sflo:hasWorkingLocatedFile <world/checkpoint-manifests/inn-ambush-checkpoints/_knop/_meta/meta.ttl> ;
  sflo:hasResourcePage <world/checkpoint-manifests/inn-ambush-checkpoints/_knop/_meta/index.html> .

<world/checkpoint-manifests/inn-ambush-checkpoints/_knop/_inventory> a sflo:KnopInventory, sflo:DigitalArtifact, sflo:RdfDocument ;
  sflo:hasWorkingLocatedFile <world/checkpoint-manifests/inn-ambush-checkpoints/_knop/_inventory/inventory.ttl> ;
  sflo:hasResourcePage <world/checkpoint-manifests/inn-ambush-checkpoints/_knop/_inventory/index.html> .

<world/checkpoint-manifests/inn-ambush-checkpoints/_knop/_meta/meta.ttl> a sflo:LocatedFile, sflo:RdfDocument .

<world/checkpoint-manifests/inn-ambush-checkpoints/_knop/_inventory/inventory.ttl> a sflo:LocatedFile, sflo:RdfDocument .

<world/checkpoint-manifests/inn-ambush-checkpoints/checkpoint-manifest.ttl> a sflo:LocatedFile, sflo:RdfDocument .

<world/checkpoint-manifests/inn-ambush-checkpoints/index.html> a sflo:ResourcePage, sflo:LocatedFile .

<world/checkpoint-manifests/inn-ambush-checkpoints/_knop/index.html> a sflo:ResourcePage, sflo:LocatedFile .

<world/checkpoint-manifests/inn-ambush-checkpoints/_knop/_meta/index.html> a sflo:ResourcePage, sflo:LocatedFile .

<world/checkpoint-manifests/inn-ambush-checkpoints/_knop/_inventory/index.html> a sflo:ResourcePage, sflo:LocatedFile .
