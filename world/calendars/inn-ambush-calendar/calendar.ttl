<https://spectacular-voyage.github.io/test-inn-ambush/world/calendars/inn-ambush-calendar> a dcat:Dataset;
    cat:instanceOf tmpo:Calendar;
    dcterms:title "Inn Ambush custom calendar";
    dcterms:description "Fixture custom calendar for deriving prose world time from world-clock axis offsets. Curated CSV tables are the permanent authoring surface; this Turtle is their RDF projection for runtime reads.";
    dcterms:created "2026-07-05"^^xsd:date;
    tmpo:calendarKind tmpo:calendarKind_custom;
    tmpo:secondsPerDay 86400.0;
    tmpo:epochYear 1;
    tmpo:epochDayOfYear 0;
    tmpo:epochSecondOfDay 74580.0;
    tmpo:epochWeekdayOrdinal 0;
    tmpo:hasWeekday <https://spectacular-voyage.github.io/test-inn-ambush/world/calendars/inn-ambush-calendar/weekday/ashday>, <https://spectacular-voyage.github.io/test-inn-ambush/world/calendars/inn-ambush-calendar/weekday/barrowday>, <https://spectacular-voyage.github.io/test-inn-ambush/world/calendars/inn-ambush-calendar/weekday/coinday>, <https://spectacular-voyage.github.io/test-inn-ambush/world/calendars/inn-ambush-calendar/weekday/driftday>, <https://spectacular-voyage.github.io/test-inn-ambush/world/calendars/inn-ambush-calendar/weekday/eveday>;
    tmpo:hasMonth <https://spectacular-voyage.github.io/test-inn-ambush/world/calendars/inn-ambush-calendar/month/emberwane>, <https://spectacular-voyage.github.io/test-inn-ambush/world/calendars/inn-ambush-calendar/month/rainmoot>, <https://spectacular-voyage.github.io/test-inn-ambush/world/calendars/inn-ambush-calendar/month/leafturn>, <https://spectacular-voyage.github.io/test-inn-ambush/world/calendars/inn-ambush-calendar/month/frostwane>, <https://spectacular-voyage.github.io/test-inn-ambush/world/calendars/inn-ambush-calendar/month/deepfrost>, <https://spectacular-voyage.github.io/test-inn-ambush/world/calendars/inn-ambush-calendar/month/thawcall>, <https://spectacular-voyage.github.io/test-inn-ambush/world/calendars/inn-ambush-calendar/month/seedmoot>, <https://spectacular-voyage.github.io/test-inn-ambush/world/calendars/inn-ambush-calendar/month/suncrest>, <https://spectacular-voyage.github.io/test-inn-ambush/world/calendars/inn-ambush-calendar/month/highsun>, <https://spectacular-voyage.github.io/test-inn-ambush/world/calendars/inn-ambush-calendar/month/harvestwane>, <https://spectacular-voyage.github.io/test-inn-ambush/world/calendars/inn-ambush-calendar/month/mistfall>, <https://spectacular-voyage.github.io/test-inn-ambush/world/calendars/inn-ambush-calendar/month/longnight>;
    tmpo:hasSeason <https://spectacular-voyage.github.io/test-inn-ambush/world/calendars/inn-ambush-calendar/season/early-autumn>, <https://spectacular-voyage.github.io/test-inn-ambush/world/calendars/inn-ambush-calendar/season/deep-winter>, <https://spectacular-voyage.github.io/test-inn-ambush/world/calendars/inn-ambush-calendar/season/new-spring>, <https://spectacular-voyage.github.io/test-inn-ambush/world/calendars/inn-ambush-calendar/season/high-summer>;
    tmpo:hasTimeOfDayBand <https://spectacular-voyage.github.io/test-inn-ambush/world/calendars/inn-ambush-calendar/band/night-before-dawn>, <https://spectacular-voyage.github.io/test-inn-ambush/world/calendars/inn-ambush-calendar/band/early-morning>, <https://spectacular-voyage.github.io/test-inn-ambush/world/calendars/inn-ambush-calendar/band/midmorning>, <https://spectacular-voyage.github.io/test-inn-ambush/world/calendars/inn-ambush-calendar/band/midday>, <https://spectacular-voyage.github.io/test-inn-ambush/world/calendars/inn-ambush-calendar/band/afternoon>, <https://spectacular-voyage.github.io/test-inn-ambush/world/calendars/inn-ambush-calendar/band/late-evening>, <https://spectacular-voyage.github.io/test-inn-ambush/world/calendars/inn-ambush-calendar/band/night-after-evening>;
    dcat:distribution <https://spectacular-voyage.github.io/test-inn-ambush/world/calendars/inn-ambush-calendar/weekdays-csv>, <https://spectacular-voyage.github.io/test-inn-ambush/world/calendars/inn-ambush-calendar/months-csv>, <https://spectacular-voyage.github.io/test-inn-ambush/world/calendars/inn-ambush-calendar/seasons-csv>, <https://spectacular-voyage.github.io/test-inn-ambush/world/calendars/inn-ambush-calendar/bands-csv>, <https://spectacular-voyage.github.io/test-inn-ambush/world/calendars/inn-ambush-calendar/calendar-csvw>.
