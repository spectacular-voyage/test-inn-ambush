@base <https://spectacular-voyage.github.io/test-inn-ambush/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<projections/notifications/plan-b-projection-ready/_knop> a sflo:Knop ;
  sflo:hasKnopMetadata <projections/notifications/plan-b-projection-ready/_knop/_meta> ;
  sflo:hasKnopInventory <projections/notifications/plan-b-projection-ready/_knop/_inventory> ;
  sflo:hasWorkingKnopInventoryFile <projections/notifications/plan-b-projection-ready/_knop/_inventory/inventory.ttl> ;
  sflo:hasPayloadArtifact <projections/notifications/plan-b-projection-ready> ;
  sflo:hasResourcePage <projections/notifications/plan-b-projection-ready/_knop/index.html> .

<projections/notifications/plan-b-projection-ready> a sflo:PayloadArtifact, sflo:DigitalArtifact ;
  sflo:nextHistoryOrdinal "2"^^xsd:nonNegativeInteger ;
  sflo:hasWorkingLocatedFile <projections/notifications/plan-b-projection-ready/plan-b-projection-ready.json> ;
  sflo:hasResourcePage <projections/notifications/plan-b-projection-ready/index.html> .

<projections/notifications/plan-b-projection-ready/_knop/_meta> a sflo:KnopMetadata, sflo:DigitalArtifact, sflo:RdfDocument ;
  sflo:hasWorkingLocatedFile <projections/notifications/plan-b-projection-ready/_knop/_meta/meta.ttl> ;
  sflo:hasResourcePage <projections/notifications/plan-b-projection-ready/_knop/_meta/index.html> .

<projections/notifications/plan-b-projection-ready/_knop/_inventory> a sflo:KnopInventory, sflo:DigitalArtifact, sflo:RdfDocument ;
  sflo:hasWorkingLocatedFile <projections/notifications/plan-b-projection-ready/_knop/_inventory/inventory.ttl> ;
  sflo:hasResourcePage <projections/notifications/plan-b-projection-ready/_knop/_inventory/index.html> .

<projections/notifications/plan-b-projection-ready/_knop/_meta/meta.ttl> a sflo:LocatedFile, sflo:RdfDocument .

<projections/notifications/plan-b-projection-ready/_knop/_inventory/inventory.ttl> a sflo:LocatedFile, sflo:RdfDocument .

<projections/notifications/plan-b-projection-ready/plan-b-projection-ready.json> a sflo:LocatedFile .

<projections/notifications/plan-b-projection-ready/index.html> a sflo:ResourcePage, sflo:LocatedFile .

<projections/notifications/plan-b-projection-ready/_knop/index.html> a sflo:ResourcePage, sflo:LocatedFile .

<projections/notifications/plan-b-projection-ready/_knop/_meta/index.html> a sflo:ResourcePage, sflo:LocatedFile .

<projections/notifications/plan-b-projection-ready/_knop/_inventory/index.html> a sflo:ResourcePage, sflo:LocatedFile .
