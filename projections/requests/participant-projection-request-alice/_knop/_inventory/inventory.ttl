@base <https://spectacular-voyage.github.io/test-inn-ambush/> .
@prefix sflo: <https://semantic-flow.github.io/sflo/ontology/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<projections/requests/participant-projection-request-alice/_knop> a sflo:Knop ;
  sflo:hasKnopMetadata <projections/requests/participant-projection-request-alice/_knop/_meta> ;
  sflo:hasKnopInventory <projections/requests/participant-projection-request-alice/_knop/_inventory> ;
