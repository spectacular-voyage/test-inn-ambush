<projections/requests/participant-projection-request-alice/_knop/_meta> a sflo:KnopMetadata, sflo:DigitalArtifact, sflo:RdfDocument ;
  sflo:hasWorkingLocatedFile <projections/requests/participant-projection-request-alice/_knop/_meta/meta.ttl> ;
