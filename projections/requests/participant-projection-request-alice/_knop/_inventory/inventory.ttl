<projections/requests/participant-projection-request-alice> a sflo:PayloadArtifact, sflo:DigitalArtifact ;
  sflo:nextHistoryOrdinal "2"^^xsd:nonNegativeInteger ;
  sflo:hasWorkingLocatedFile <projections/requests/participant-projection-request-alice/participant-projection-request-alice.json> ;
