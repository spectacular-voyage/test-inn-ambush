<projections/requests/participant-projection-request-alice/_knop/_inventory> a sflo:KnopInventory, sflo:DigitalArtifact, sflo:RdfDocument ;
  sflo:hasWorkingLocatedFile <projections/requests/participant-projection-request-alice/_knop/_inventory/inventory.ttl> ;
  sflo:hasResourcePage <projections/requests/participant-projection-request-alice/_knop/_inventory/index.html> .

<projections/requests/participant-projection-request-alice/_knop/_meta/meta.ttl> a sflo:LocatedFile, sflo:RdfDocument .

<projections/requests/participant-projection-request-alice/_knop/_inventory/inventory.ttl> a sflo:LocatedFile, sflo:RdfDocument .

<projections/requests/participant-projection-request-alice/participant-projection-request-alice.json> a sflo:LocatedFile .

<projections/requests/participant-projection-request-alice/index.html> a sflo:ResourcePage, sflo:LocatedFile .

