        {
          "id": "#roleosum-shapes-rdf-endpoint",
          "type": "RdfExpectation",
          "targetsFileExpectation": "#projections-contracts-inn-ambush-contract-shapes-ttl",
          "hasAskAssertion": [
            {
              "id": "#ask-trade-price-line-shape-family-class",
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://spectacular-voyage.github.io/stagecraft/shacl/TradePriceLineShape> a <http://www.w3.org/ns/shacl#NodeShape> ; <http://www.w3.org/ns/shacl#class> <https://roleosum.github.io/ontology/TradePriceLine> . }",
              "expectedBoolean": true
            }
          ]
        },
        {
          "id": "#roleosum-world-state-rdf-endpoint",
          "type": "RdfExpectation",
          "targetsFileExpectation": "#world-states-inn-ambush-plan-b-state-inn-ambush-plan-b-state-ttl",
          "hasAskAssertion": [
            {
              "id": "#ask-talla-value-declaration-endpoint",
              "type": "SparqlAskAssertion",
              "query": "ASK { <https://spectacular-voyage.github.io/test-inn-ambush/value-declaration/talla/honest-trader> a <https://roleosum.github.io/ontology/ValueDeclaration> ; <https://roleosum.github.io/ontology/declarationSubject> <https://spectacular-voyage.github.io/test-inn-ambush/npc/talla-mosswick> ; <https://roleosum.github.io/ontology/declarationTerm> <https://roleosum.github.io/ontology/valueKind_ideal> . }",
              "expectedBoolean": true
