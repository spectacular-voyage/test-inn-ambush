  "type": "Manifest",
  "id": "urn:accord:stagecraft:test-inn-ambush:86-calendar-cluster-cutover",
  "dcterms:title": "Inn Ambush 86 calendar cluster cutover — the calendar rewritten from the v1 temporaenum vocabulary to the temporaenum arm's (stagecraft seating seven, 2026-08-20; this rung cut by seating eight)",
  "hasCase": [
    {
      "type": "TransitionCase",
      "id": "#calendar-cluster-cutover",
      "fixtureRepo": "github.com/spectacular-voyage/test-inn-ambush",
      "operationId": "stagecraft.platform.rewriteCalendarToTemporaenumArm",
      "fromRef": "e0db9f45a1fc700493986c9bbe965be9a5d3dd35",
      "toRef": "a.86-calendar-cluster-cutover",
      "fromState": {
        "type": "StateLocator",
        "locatorKind": "gitRefState",
        "ref": "e0db9f45a1fc700493986c9bbe965be9a5d3dd35"
      },
      "toState": {
        "type": "StateLocator",
        "locatorKind": "gitRefState",
        "ref": "a.86-calendar-cluster-cutover"
      },
      "hasFileExpectation": [
        {
          "id": "#calendar-rdf",
          "type": "FileExpectation",
          "path": "world/calendars/inn-ambush-calendar/calendar.ttl",
          "changeType": "updated",
          "compareMode": "rdfCanonical"
        },
        {
          "id": "#bands-csv-unchanged",
          "type": "FileExpectation",
          "path": "world/calendars/inn-ambush-calendar/bands.csv",
          "changeType": "unchanged",
          "compareMode": "bytes"
        },
        {
          "id": "#months-csv-unchanged",
          "type": "FileExpectation",
          "path": "world/calendars/inn-ambush-calendar/months.csv",
          "changeType": "unchanged",
          "compareMode": "bytes"
        },
        {
          "id": "#seasons-csv-unchanged",
          "type": "FileExpectation",
          "path": "world/calendars/inn-ambush-calendar/seasons.csv",
          "changeType": "unchanged",
          "compareMode": "bytes"
        },
        {
          "id": "#weekdays-csv-unchanged",
          "type": "FileExpectation",
          "path": "world/calendars/inn-ambush-calendar/weekdays.csv",
          "changeType": "unchanged",
          "compareMode": "bytes"
        },
        {
          "id": "#calendar-csvw-unchanged",
          "type": "FileExpectation",
          "path": "world/calendars/inn-ambush-calendar/calendar.csvw.json",
