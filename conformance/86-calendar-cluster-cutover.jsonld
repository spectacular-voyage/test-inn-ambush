      ],
      "hasRdfExpectation": [
        {
          "id": "#calendar-rdf-assertions",
          "type": "RdfExpectation",
          "targetsFileExpectation": "#calendar-rdf",
          "hasAskAssertion": [
            {
              "id": "#ask-alphabetical-weekdays-target",
              "type": "SparqlAskAssertion",
              "query": "ASK {\n  <https://spectacular-voyage.github.io/test-inn-ambush/world/calendars/inn-ambush-calendar> <https://temporaenum.github.io/ontology/hasWeekday> <https://spectacular-voyage.github.io/test-inn-ambush/world/calendars/inn-ambush-calendar/weekday/ashday>,\n      <https://spectacular-voyage.github.io/test-inn-ambush/world/calendars/inn-ambush-calendar/weekday/barrowday>,\n      <https://spectacular-voyage.github.io/test-inn-ambush/world/calendars/inn-ambush-calendar/weekday/coinday>,\n      <https://spectacular-voyage.github.io/test-inn-ambush/world/calendars/inn-ambush-calendar/weekday/driftday>,\n      <https://spectacular-voyage.github.io/test-inn-ambush/world/calendars/inn-ambush-calendar/weekday/eveday> .\n  <https://spectacular-voyage.github.io/test-inn-ambush/world/calendars/inn-ambush-calendar/weekday/ashday> <http://www.w3.org/2000/01/rdf-schema#label> \"Ashday\" ;\n    <https://temporaenum.github.io/ontology/calendarKey> \"ashday\" ;\n    <https://temporaenum.github.io/ontology/ordinal> 0 .\n  <https://spectacular-voyage.github.io/test-inn-ambush/world/calendars/inn-ambush-calendar/weekday/barrowday> <http://www.w3.org/2000/01/rdf-schema#label> \"Barrowday\" ;\n    <https://temporaenum.github.io/ontology/calendarKey> \"barrowday\" ;\n    <https://temporaenum.github.io/ontology/ordinal> 1 .\n  <https://spectacular-voyage.github.io/test-inn-ambush/world/calendars/inn-ambush-calendar/weekday/eveday> <http://www.w3.org/2000/01/rdf-schema#label> \"Eveday\" ;\n    <https://temporaenum.github.io/ontology/calendarKey> \"eveday\" ;\n    <https://temporaenum.github.io/ontology/ordinal> 4 .\n  FILTER NOT EXISTS { <https://spectacular-voyage.github.io/test-inn-ambush/world/calendars/inn-ambush-calendar/weekday/toilday> ?oldToilPredicate ?oldToilObject .\n  } FILTER NOT EXISTS { <https://spectacular-voyage.github.io/test-inn-ambush/world/calendars/inn-ambush-calendar/weekday/starday> ?oldStarPredicate ?oldStarObject .\n  }\n}",
              "expectedBoolean": true
            }
          ]
        },
        {
          "id": "#world-state-assertions",
          "type": "RdfExpectation",
          "targetsFileExpectation": "#world-state-unchanged",
          "hasAskAssertion": [
            {
              "id": "#ask-calendar-definitions-not-copied-target",
              "type": "SparqlAskAssertion",
              "query": "ASK {\n  ?band <https://categoriae.github.io/ontology/instanceOf> <https://temporaenum.github.io/ontology/TimeOfDayBand> .\n}",
              "expectedBoolean": false
            }
          ]
        }
      ]
    }
  ]
