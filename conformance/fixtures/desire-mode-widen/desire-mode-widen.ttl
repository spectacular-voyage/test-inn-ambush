  psy:authorshipBasis psy:authorshipKind_implanted ;
  psy:causedBy <https://spectacular-voyage.github.io/test-inn-ambush/authority-journal/spell/suggestion-old-road-001> ;
  psy:activeFrom "2026-07-07T19:55:00Z"^^xsd:dateTime ;
  psy:activeUntil "2026-07-07T20:05:00Z"^^xsd:dateTime ;
  psy:compulsionGrade psy:compulsionGradeKind_compelled ;
  psy:removedBy <https://spectacular-voyage.github.io/test-inn-ambush/authority-journal/spell-expiry/suggestion-old-road-001> ;
  psy:evidences <https://spectacular-voyage.github.io/test-inn-ambush/desire-mode/elara/old-road-compulsion> .

