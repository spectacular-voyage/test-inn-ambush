@prefix cat: <https://categoriae.github.io/ontology/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix par: <https://participatorium.github.io/ontology/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sc: <https://spectacular-voyage.github.io/stagecraft/ontology/> .
@prefix srd521: <https://stagecraft.github.io/srd-rules/srd-5-2-1/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://spectacular-voyage.github.io/test-inn-ambush/rules/dynamis/srd-starter>
  a dcat:Dataset ;
  dcterms:title "Inn Ambush Dynamis SRD starter rules" ;
  dcterms:description "A small fixture rules package proving Dynamis ActionType, affordance-mask, and decision-table data shapes. It is not a full SRD extraction." ;
  dcterms:created "2026-07-05"^^xsd:date ;
  dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
  dcterms:source <https://dnd.wizards.com/resources/systems-reference-document> ;
  dcterms:rights "Includes material taken from System Reference Document 5.1 by Wizards of the Coast LLC, available under the Creative Commons Attribution 4.0 International License." ;
  dcat:distribution <https://spectacular-voyage.github.io/test-inn-ambush/rules/dynamis/srd-starter/decision-table-csv> .

<https://spectacular-voyage.github.io/test-inn-ambush/rules/dynamis/srd-starter/decision-table-csv>
  a dcat:Distribution ;
  dcterms:title "SRD starter decision table CSV" ;
  dcat:downloadURL <https://spectacular-voyage.github.io/test-inn-ambush/rules/dynamis/srd-starter/dynamis-srd-starter.decision-table.csv> .

<https://spectacular-voyage.github.io/test-inn-ambush/rules/dynamis/srd-starter/action-table>
  a par:DecisionTable ;
  dcterms:isPartOf <https://spectacular-voyage.github.io/test-inn-ambush/rules/dynamis/srd-starter> ;
  srd521:hitPolicy "first" .

par:Move
  a par:ActionType ;
  rdfs:label "Movement" ;
  par:preconditionAsk <https://spectacular-voyage.github.io/test-inn-ambush/rules/dynamis/srd-starter/ask/move> ;
  par:consequenceTemplate <https://spectacular-voyage.github.io/test-inn-ambush/rules/dynamis/srd-starter/template/move> ;
  srd521:srdReference "SRD 5.1 movement rules" .

<https://spectacular-voyage.github.io/test-inn-ambush/rules/dynamis/srd-starter/ask/move>
  a par:SparqlAskPrecondition ;
  rdf:value """ASK {
  GRAPH ?stateGraph {
    VALUES (?actant ?fromPlace ?toPlace ?asOf) { (?actantValue ?fromPlaceValue ?toPlaceValue ?asOfValue) }
    ?fromPlace sc:adjacentTo ?toPlace .
    ?location a sc:LocatedInRelator ;
      sc:subject ?actant ;
      sc:predicate sc:locatedIn ;
      sc:object ?fromPlace ;
      sc:acceptedFrom ?acceptedFrom .
    FILTER(?acceptedFrom <= ?asOf)
    FILTER NOT EXISTS {
      ?location sc:acceptedUntil ?acceptedUntil .
      FILTER(?acceptedUntil <= ?asOf)
    }
  }
}""" .

<https://spectacular-voyage.github.io/test-inn-ambush/rules/dynamis/srd-starter/template/move>
  a par:ConsequenceTemplate ;
  rdf:value "Close the current sc:locatedIn relator for the actant and open a new sc:LocatedInRelator at the destination place, carrying authority and committed-event provenance." .

<https://spectacular-voyage.github.io/test-inn-ambush/rules/dynamis/srd-starter/rule/movement>
  a par:DecisionRule ;
  dcterms:isPartOf <https://spectacular-voyage.github.io/test-inn-ambush/rules/dynamis/srd-starter/action-table> ;
  srd521:actionType par:Move ;
  par:preconditionAsk <https://spectacular-voyage.github.io/test-inn-ambush/rules/dynamis/srd-starter/ask/move> ;
  par:consequenceTemplate <https://spectacular-voyage.github.io/test-inn-ambush/rules/dynamis/srd-starter/template/move> ;
  srd521:srdReference "SRD 5.1 movement rules" ;
  srd521:starterStatus "starter" .

par:Speak
  a par:ActionType ;
  rdfs:label "Speak" ;
  par:preconditionAsk <https://spectacular-voyage.github.io/test-inn-ambush/rules/dynamis/srd-starter/ask/speak> ;
  par:consequenceTemplate <https://spectacular-voyage.github.io/test-inn-ambush/rules/dynamis/srd-starter/template/speech-event> ;
  srd521:srdReference "Stagecraft dialogue doctrine plus SRD 5.1 silence mask pattern" .

<https://spectacular-voyage.github.io/test-inn-ambush/rules/dynamis/srd-starter/ask/speak>
  a par:SparqlAskPrecondition ;
  rdf:value """ASK {
  GRAPH ?stateGraph {
    VALUES (?actant ?actionType ?asOf) { (?actantValue par:Speak ?asOfValue) }
    FILTER NOT EXISTS {
      ?mask a par:AffordanceMask ;
        par:masksActionType ?actionType ;
        par:maskedActant ?actant ;
        sc:acceptedFrom ?acceptedFrom .
      FILTER(?acceptedFrom <= ?asOf)
      FILTER NOT EXISTS {
        ?mask sc:acceptedUntil ?acceptedUntil .
        FILTER(?acceptedUntil <= ?asOf)
      }
    }
  }
}""" .

<https://spectacular-voyage.github.io/test-inn-ambush/rules/dynamis/srd-starter/template/speech-event>
  a par:ConsequenceTemplate ;
  rdf:value "Commit a speech event without a state mutation; any founded effect is a separate tier-2 or tier-3 record." .

<https://spectacular-voyage.github.io/test-inn-ambush/rules/dynamis/srd-starter/rule/speak>
  a par:DecisionRule ;
  dcterms:isPartOf <https://spectacular-voyage.github.io/test-inn-ambush/rules/dynamis/srd-starter/action-table> ;
  srd521:actionType par:Speak ;
  par:preconditionAsk <https://spectacular-voyage.github.io/test-inn-ambush/rules/dynamis/srd-starter/ask/speak> ;
  par:consequenceTemplate <https://spectacular-voyage.github.io/test-inn-ambush/rules/dynamis/srd-starter/template/speech-event> ;
  srd521:srdReference "Stagecraft dialogue doctrine plus SRD 5.1 silence mask pattern" ;
  srd521:starterStatus "starter" .

srd521:Attune
  a par:ActionType ;
  rdfs:label "Attune" ;
  par:preconditionAsk <https://spectacular-voyage.github.io/test-inn-ambush/rules/dynamis/srd-starter/ask/attune> ;
  par:consequenceTemplate <https://spectacular-voyage.github.io/test-inn-ambush/rules/dynamis/srd-starter/template/attune> ;
  srd521:srdReference "SRD 5.1 attunement rules" .

<https://spectacular-voyage.github.io/test-inn-ambush/rules/dynamis/srd-starter/ask/attune>
  a par:SparqlAskPrecondition ;
  rdf:value """ASK {
  GRAPH ?stateGraph {
    VALUES (?actant ?item ?asOf) { (?actantValue ?itemValue ?asOfValue) }
    ?item par:affords srd521:Attune .
    FILTER NOT EXISTS {
      ?mask a par:AffordanceMask ;
        par:masksActionType srd521:Attune ;
        par:maskedActant ?actant ;
        sc:acceptedFrom ?acceptedFrom .
      FILTER(?acceptedFrom <= ?asOf)
      FILTER NOT EXISTS {
        ?mask sc:acceptedUntil ?acceptedUntil .
        FILTER(?acceptedUntil <= ?asOf)
      }
    }
  }
}""" .

<https://spectacular-voyage.github.io/test-inn-ambush/rules/dynamis/srd-starter/template/attune>
  a par:ConsequenceTemplate ;
  rdf:value "Open an interval-qualified attunement relator between the actant and item when authority accepts the completed action." .

<https://spectacular-voyage.github.io/test-inn-ambush/rules/dynamis/srd-starter/rule/attune>
  a par:DecisionRule ;
  dcterms:isPartOf <https://spectacular-voyage.github.io/test-inn-ambush/rules/dynamis/srd-starter/action-table> ;
  srd521:actionType srd521:Attune ;
  par:preconditionAsk <https://spectacular-voyage.github.io/test-inn-ambush/rules/dynamis/srd-starter/ask/attune> ;
  par:consequenceTemplate <https://spectacular-voyage.github.io/test-inn-ambush/rules/dynamis/srd-starter/template/attune> ;
  srd521:srdReference "SRD 5.1 attunement rules" ;
  srd521:starterStatus "stretch" .
