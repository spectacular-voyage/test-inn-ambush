@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix dcat: <http://www.w3.org/ns/dcat#>.
@prefix cat: <https://categoriae.github.io/ontology/>.
@prefix kosm: <https://kosmion.github.io/ontology/>.
@prefix par: <https://participatorium.github.io/ontology/>.
@prefix srd521: <https://stagecraft.github.io/srd-rules/srd-5-2-1/>.

srd521:attack-roll-kinds dcterms:source <https://media.dndbeyond.com/compendium-images/srd/5.2/SRD_CC_v5.2.1.pdf>;
    dcterms:title "SRD 5.2.1 attack-roll-kinds"@en;
    a dcat:Dataset.
<https://stagecraft.github.io/srd-rules/srd-5-2-1/attack-roll-kinds/melee> cat:instanceOf srd521:AttackRollKind;
    a cat:Individual;
    rdfs:comment "The SRD 5.2.1 spell attack-roll kind Melee.";
    rdfs:label "Melee"@en;
    cat:lexicalToken "melee".
<https://stagecraft.github.io/srd-rules/srd-5-2-1/attack-roll-kinds/melee-and-ranged> cat:instanceOf srd521:AttackRollKind;
    a cat:Individual;
    rdfs:comment "The SRD 5.2.1 spell attack-roll kind Melee and ranged.";
    rdfs:label "Melee and ranged"@en;
    cat:lexicalToken "melee-and-ranged".
<https://stagecraft.github.io/srd-rules/srd-5-2-1/attack-roll-kinds/ranged> cat:instanceOf srd521:AttackRollKind;
    a cat:Individual;
    rdfs:comment "The SRD 5.2.1 spell attack-roll kind Ranged.";
    rdfs:label "Ranged"@en;
    cat:lexicalToken "ranged".
<https://stagecraft.github.io/srd-rules/srd-5-2-1/attack-roll-kinds/unspecified> cat:instanceOf srd521:AttackRollKind;
    a cat:Individual;
    rdfs:comment "The SRD 5.2.1 spell attack-roll kind Unspecified.";
    rdfs:label "Unspecified"@en;
    cat:lexicalToken "unspecified".
