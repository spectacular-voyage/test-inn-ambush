srd521:effect-kinds dcterms:source <https://media.dndbeyond.com/compendium-images/srd/5.2/SRD_CC_v5.2.1.pdf>;
    dcterms:title "SRD 5.2.1 effect-kinds"@en;
    a dcat:Dataset.
<https://stagecraft.github.io/srd-rules/srd-5-2-1/effect-kinds/affordance-mask> cat:instanceOf srd521:EffectKind;
    a cat:Individual;
    rdfs:comment "The SRD 5.2.1 condition-effect mechanics kind Affordance mask.";
    rdfs:label "Affordance mask"@en;
