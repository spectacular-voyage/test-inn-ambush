@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix dcat: <http://www.w3.org/ns/dcat#>.
@prefix cat: <https://categoriae.github.io/ontology/>.
@prefix kosm: <https://kosmion.github.io/ontology/>.
@prefix par: <https://participatorium.github.io/ontology/>.
@prefix srd521: <https://stagecraft.github.io/srd-rules/srd-5-2-1/>.

srd521:action-economy-tags dcterms:source <https://media.dndbeyond.com/compendium-images/srd/5.2/SRD_CC_v5.2.1.pdf>;
    dcterms:title "SRD 5.2.1 action-economy-tags"@en;
    a dcat:Dataset.
<https://stagecraft.github.io/srd-rules/srd-5-2-1/action-economy-tags/action> cat:instanceOf srd521:ActionEconomyTag;
    a cat:Individual;
    rdfs:comment "The SRD 5.2.1 action-economy tag Action.";
    rdfs:label "Action"@en;
    cat:lexicalToken "action".
<https://stagecraft.github.io/srd-rules/srd-5-2-1/action-economy-tags/bonus-action> cat:instanceOf srd521:ActionEconomyTag;
    a cat:Individual;
    rdfs:comment "The SRD 5.2.1 action-economy tag Bonus action.";
    rdfs:label "Bonus action"@en;
    cat:lexicalToken "bonus-action".
<https://stagecraft.github.io/srd-rules/srd-5-2-1/action-economy-tags/long-cast> cat:instanceOf srd521:ActionEconomyTag;
    a cat:Individual;
    rdfs:comment "The SRD 5.2.1 action-economy tag Long cast.";
    rdfs:label "Long cast"@en;
    cat:lexicalToken "long-cast".
<https://stagecraft.github.io/srd-rules/srd-5-2-1/action-economy-tags/reaction> cat:instanceOf srd521:ActionEconomyTag;
    a cat:Individual;
    rdfs:comment "The SRD 5.2.1 action-economy tag Reaction.";
    rdfs:label "Reaction"@en;
    cat:lexicalToken "reaction".
