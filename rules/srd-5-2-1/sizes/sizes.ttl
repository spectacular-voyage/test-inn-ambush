@prefix srd521: <https://stagecraft.github.io/srd-rules/srd-5-2-1/>.

srd521:sizes dcterms:source <https://media.dndbeyond.com/compendium-images/srd/5.2/SRD_CC_v5.2.1.pdf>;
    dcterms:title "SRD 5.2.1 sizes"@en;
    a dcat:Dataset.
<https://stagecraft.github.io/srd-rules/srd-5-2-1/sizes/gargantuan> cat:instanceOf srd521:SizeKind;
    a cat:Individual;
    rdfs:comment "The SRD 5.2.1 creature size Gargantuan.";
    rdfs:label "Gargantuan"@en;
    cat:lexicalToken "gargantuan".
