<https://stagecraft.github.io/srd-rules/srd-5-2-1/conditions/exhaustion> cat:instanceOf srd521:ConditionDefinition;
    a cat:Description;
    rdfs:comment "The SRD 5.2.1 condition named Exhaustion."@en;
    rdfs:label "Exhaustion"@en;
    cat:lexicalToken "exhaustion";
    srd521:hasConditionEffect <https://stagecraft.github.io/srd-rules/srd-5-2-1/conditions/exhaustion-d20-tests-affected>, <https://stagecraft.github.io/srd-rules/srd-5-2-1/conditions/exhaustion-exhaustion-levels>, <https://stagecraft.github.io/srd-rules/srd-5-2-1/conditions/exhaustion-removing-exhaustion-levels>, <https://stagecraft.github.io/srd-rules/srd-5-2-1/conditions/exhaustion-speed-reduced>;
    srd521:sourceSection "Rules Glossary: Exhaustion [Condition]".
<https://stagecraft.github.io/srd-rules/srd-5-2-1/conditions/exhaustion-d20-tests-affected> dcterms:description "When you make a D20 Test, the roll is reduced by 2 times your Exhaustion level.";
    dcterms:isPartOf <https://stagecraft.github.io/srd-rules/srd-5-2-1/conditions/exhaustion>;
    cat:instanceOf srd521:ConditionEffect;
    a cat:Description;
    rdfs:label "D20 Tests Affected"@en;
    par:adjudicationNote "The roll reduction is mechanical but is not an action mask.";
    srd521:conditionEffectType <https://stagecraft.github.io/srd-rules/srd-5-2-1/condition-effects/d20-tests-affected>;
    srd521:effectKind <https://stagecraft.github.io/srd-rules/srd-5-2-1/effect-kinds/d20-modifier>;
    srd521:mechanicalStatus <https://stagecraft.github.io/srd-rules/srd-5-2-1/mechanical-statuses/structured-not-mask>;
    srd521:sourceSection "Rules Glossary: Exhaustion [Condition]".
<https://stagecraft.github.io/srd-rules/srd-5-2-1/conditions/exhaustion-exhaustion-levels> dcterms:description "This condition is cumulative. Each time you receive it, you gain 1 Exhaustion level. You die if your Exhaustion level is 6.";
    dcterms:isPartOf <https://stagecraft.github.io/srd-rules/srd-5-2-1/conditions/exhaustion>;
    cat:instanceOf srd521:ConditionEffect;
    a cat:Description;
    rdfs:label "Exhaustion Levels"@en;
    par:adjudicationNote "Exhaustion levels are cumulative condition state, not an affordance mask.";
    srd521:conditionEffectType <https://stagecraft.github.io/srd-rules/srd-5-2-1/condition-effects/exhaustion-levels>;
    srd521:effectKind <https://stagecraft.github.io/srd-rules/srd-5-2-1/effect-kinds/condition-counter>;
    srd521:mechanicalStatus <https://stagecraft.github.io/srd-rules/srd-5-2-1/mechanical-statuses/structured-not-mask>;
    srd521:sourceSection "Rules Glossary: Exhaustion [Condition]".
<https://stagecraft.github.io/srd-rules/srd-5-2-1/conditions/exhaustion-removing-exhaustion-levels> dcterms:description "Finishing a Long Rest removes 1 of your Exhaustion levels. When your Exhaustion level reaches 0, the condition ends.";
    dcterms:isPartOf <https://stagecraft.github.io/srd-rules/srd-5-2-1/conditions/exhaustion>;
    cat:instanceOf srd521:ConditionEffect;
    a cat:Description;
    rdfs:label "Removing Exhaustion Levels"@en;
    par:adjudicationNote "Recovery timing is condition lifecycle data, not an action mask.";
    srd521:conditionEffectType <https://stagecraft.github.io/srd-rules/srd-5-2-1/condition-effects/removing-exhaustion-levels>;
    srd521:effectKind <https://stagecraft.github.io/srd-rules/srd-5-2-1/effect-kinds/condition-recovery>;
    srd521:mechanicalStatus <https://stagecraft.github.io/srd-rules/srd-5-2-1/mechanical-statuses/structured-not-mask>;
    srd521:sourceSection "Rules Glossary: Exhaustion [Condition]".
<https://stagecraft.github.io/srd-rules/srd-5-2-1/conditions/exhaustion-speed-reduced> dcterms:description "Your Speed is reduced by a number of feet equal to 5 times your Exhaustion level.";
    dcterms:isPartOf <https://stagecraft.github.io/srd-rules/srd-5-2-1/conditions/exhaustion>;
    cat:instanceOf srd521:ConditionEffect;
    a cat:Description;
    rdfs:label "Speed Reduced"@en;
    par:adjudicationNote "Speed reduction may limit movement distance without masking Move entirely.";
    srd521:conditionEffectType <https://stagecraft.github.io/srd-rules/srd-5-2-1/condition-effects/speed-reduced>;
    srd521:effectKind <https://stagecraft.github.io/srd-rules/srd-5-2-1/effect-kinds/movement-modifier>;
    srd521:mechanicalStatus <https://stagecraft.github.io/srd-rules/srd-5-2-1/mechanical-statuses/structured-not-mask>;
    srd521:sourceSection "Rules Glossary: Exhaustion [Condition]".
