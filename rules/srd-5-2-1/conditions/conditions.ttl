@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix dcat: <http://www.w3.org/ns/dcat#>.
@prefix cat: <https://categoriae.github.io/ontology/>.
@prefix kosm: <https://kosmion.github.io/ontology/>.
@prefix par: <https://participatorium.github.io/ontology/>.
@prefix srd521: <https://stagecraft.github.io/srd-rules/srd-5-2-1/>.

srd521:conditions dcterms:source <https://media.dndbeyond.com/compendium-images/srd/5.2/SRD_CC_v5.2.1.pdf>;
    dcterms:title "SRD 5.2.1 condition rules"@en;
    a dcat:Dataset.
<https://stagecraft.github.io/srd-rules/srd-5-2-1/conditions/condition-mask-adjudicated-precondition-ask> cat:instanceOf par:SparqlAskPrecondition;
    a cat:InformationObject;
    rdf:value "ASK { # Condition mask family is adjudicated by the condition effect and live mask interval. }";
    rdfs:comment "RESTORED under DF-RESTORE-1. The family regeneration DISSOLVED this individual and FLATTENED its rdf:value onto the dcterms:description of every ActionType that referenced it -- the text survived, the structure did not, and par:preconditionAsk is what packages/rules queries. Verbatim from srd-rules 56aad03262a2 srd-5-2-1/conditions/conditions.ttl:31-33.".

<https://stagecraft.github.io/srd-rules/srd-5-2-1/conditions/condition-mask-adjudicated-consequence-template> cat:instanceOf par:ConsequenceTemplate;
    a cat:Description;
    rdf:value "No standalone consequence template; this action family exists so source-derived condition masks can name the affordance they suspend.";
    rdfs:comment "RESTORED under DF-RESTORE-1, same flattening as the precondition ask above. Verbatim from srd-rules 56aad03262a2 srd-5-2-1/conditions/conditions.ttl:35-37.".

<https://stagecraft.github.io/srd-rules/srd-5-2-1/conditions/blinded> cat:instanceOf srd521:ConditionDefinition;
    a cat:Description;
    rdfs:comment "The SRD 5.2.1 condition named Blinded."@en;
    rdfs:label "Blinded"@en;
    cat:lexicalToken "blinded";
    srd521:hasConditionEffect <https://stagecraft.github.io/srd-rules/srd-5-2-1/conditions/blinded-attacks-affected>, <https://stagecraft.github.io/srd-rules/srd-5-2-1/conditions/blinded-cant-see>;
    srd521:sourceSection "Rules Glossary: Blinded [Condition]".
<https://stagecraft.github.io/srd-rules/srd-5-2-1/conditions/blinded-attacks-affected> dcterms:description "Attack rolls against you have Advantage, and your attack rolls have Disadvantage.";
    dcterms:isPartOf <https://stagecraft.github.io/srd-rules/srd-5-2-1/conditions/blinded>;
    cat:instanceOf srd521:ConditionEffect;
    a cat:Description;
    rdfs:label "Attacks Affected"@en;
    par:adjudicationNote "Attack-roll advantage and disadvantage are roll modifiers, not action masks.";
    srd521:conditionEffectType <https://stagecraft.github.io/srd-rules/srd-5-2-1/condition-effects/attacks-affected>;
    srd521:effectKind <https://stagecraft.github.io/srd-rules/srd-5-2-1/effect-kinds/d20-modifier>;
    srd521:mechanicalStatus <https://stagecraft.github.io/srd-rules/srd-5-2-1/mechanical-statuses/structured-not-mask>;
    srd521:sourceSection "Rules Glossary: Blinded [Condition]".
<https://stagecraft.github.io/srd-rules/srd-5-2-1/conditions/blinded-cant-see> dcterms:description "You can't see and automatically fail any ability check that requires sight.";
    dcterms:isPartOf <https://stagecraft.github.io/srd-rules/srd-5-2-1/conditions/blinded>;
    cat:instanceOf par:AffordanceMaskDefinition;
    a cat:Description;
    cat:instanceOf srd521:ConditionEffect;
    rdfs:label "Can't See"@en;
    par:adjudicationNote "The ability-check auto-failure depends on whether a check requires sight; the mask records the sensory affordance only.";
    par:masksActionType <https://stagecraft.github.io/srd-rules/srd-5-2-1/conditions/use-sight>;
    srd521:conditionEffectType <https://stagecraft.github.io/srd-rules/srd-5-2-1/condition-effects/cant-see>;
    srd521:effectKind <https://stagecraft.github.io/srd-rules/srd-5-2-1/effect-kinds/sensory-mask>;
    srd521:mechanicalStatus <https://stagecraft.github.io/srd-rules/srd-5-2-1/mechanical-statuses/codified-mask>;
    srd521:sourceSection "Rules Glossary: Blinded [Condition]".
<https://stagecraft.github.io/srd-rules/srd-5-2-1/conditions/charmed> cat:instanceOf srd521:ConditionDefinition;
    a cat:Description;
    rdfs:comment "The SRD 5.2.1 condition named Charmed."@en;
    rdfs:label "Charmed"@en;
    cat:lexicalToken "charmed";
    srd521:hasConditionEffect <https://stagecraft.github.io/srd-rules/srd-5-2-1/conditions/charmed-cant-harm-the-charmer>, <https://stagecraft.github.io/srd-rules/srd-5-2-1/conditions/charmed-social-advantage>;
    srd521:sourceSection "Rules Glossary: Charmed [Condition]".
<https://stagecraft.github.io/srd-rules/srd-5-2-1/conditions/charmed-cant-harm-the-charmer> dcterms:description "You can't attack the charmer or target the charmer with damaging abilities or magical effects.";
    dcterms:isPartOf <https://stagecraft.github.io/srd-rules/srd-5-2-1/conditions/charmed>;
    cat:instanceOf par:AffordanceMaskDefinition;
    a cat:Description;
    cat:instanceOf srd521:ConditionEffect;
    rdfs:label "Can't Harm the Charmer"@en;
    par:adjudicationNote "The mask is source-scoped to the charmer and does not prohibit harm against others.";
    par:masksActionType <https://stagecraft.github.io/srd-rules/srd-5-2-1/conditions/harm-condition-source>;
    srd521:conditionEffectType <https://stagecraft.github.io/srd-rules/srd-5-2-1/condition-effects/cant-harm-the-charmer>;
    srd521:effectKind <https://stagecraft.github.io/srd-rules/srd-5-2-1/effect-kinds/conditional-affordance-mask>;
    srd521:mechanicalStatus <https://stagecraft.github.io/srd-rules/srd-5-2-1/mechanical-statuses/adjudication-scoped-mask>;
    srd521:sourceSection "Rules Glossary: Charmed [Condition]".
<https://stagecraft.github.io/srd-rules/srd-5-2-1/conditions/charmed-social-advantage> dcterms:description "The charmer has Advantage on any ability check to interact with you socially.";
    dcterms:isPartOf <https://stagecraft.github.io/srd-rules/srd-5-2-1/conditions/charmed>;
    cat:instanceOf srd521:ConditionEffect;
    a cat:Description;
    rdfs:label "Social Advantage"@en;
    par:adjudicationNote "Social interaction advantage is a roll modifier, not an action mask.";
    srd521:conditionEffectType <https://stagecraft.github.io/srd-rules/srd-5-2-1/condition-effects/social-advantage>;
    srd521:effectKind <https://stagecraft.github.io/srd-rules/srd-5-2-1/effect-kinds/d20-modifier>;
    srd521:mechanicalStatus <https://stagecraft.github.io/srd-rules/srd-5-2-1/mechanical-statuses/structured-not-mask>;
    srd521:sourceSection "Rules Glossary: Charmed [Condition]".
