  cat:instanceCategory cat:Individual ;
  rdfs:label "Mechanical status"@en .

srd521:CharacterClass
  a cat:Kind ;
  cat:instanceCategory cat:Individual ;
  rdfs:label "Character class"@en .

srd521:WeaponCategory
  a cat:Kind ;
  cat:instanceCategory cat:Individual ;
  rdfs:label "Weapon category"@en .

srd521:WeaponRangeKind
  a cat:Kind ;
  cat:instanceCategory cat:Individual ;
  rdfs:label "Weapon range kind"@en .

srd521:WeaponMastery
  a cat:Kind ;
  cat:instanceCategory cat:Individual ;
  rdfs:label "Weapon mastery"@en .

srd521:AttackMode
  a cat:Kind ;
  cat:instanceCategory cat:Individual ;
  rdfs:label "Attack mode"@en .

srd521:ActionEconomyTag
  a cat:Kind ;
  cat:instanceCategory cat:Individual ;
  rdfs:label "Action economy tag"@en .

srd521:SpellRangeKind
  a cat:Kind ;
  cat:instanceCategory cat:Individual ;
  rdfs:label "Spell range kind"@en .

srd521:AreaShapeKind
  a cat:Kind ;
  cat:instanceCategory cat:Individual ;
  rdfs:label "Area shape kind"@en .

srd521:AttackRollKind
  a cat:Kind ;
  cat:instanceCategory cat:Individual ;
  rdfs:label "Attack roll kind"@en .

srd521:SpellExpressionKind
  a cat:Kind ;
  cat:instanceCategory cat:Individual ;
  rdfs:label "Spell expression kind"@en .

srd521:HealingKind
  a cat:Kind ;
  cat:instanceCategory cat:Individual ;
  rdfs:label "Healing kind"@en .

