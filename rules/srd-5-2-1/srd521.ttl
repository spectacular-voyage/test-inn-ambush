@prefix srd521: <https://stagecraft.github.io/srd-rules/srd-5-2-1/> .
@prefix cat: <https://categoriae.github.io/ontology/> .
@prefix kosm: <https://kosmion.github.io/ontology/> .
@prefix par: <https://participatorium.github.io/ontology/> .
@prefix rol: <https://roleosum.github.io/ontology/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

#################################################################
# D&D SRD 5.2.1 content vocabulary
#
# This module references the Stagecraft vocabulary family by IRI.
# It deliberately has no owl:imports and uses no SKOS.
#
# CLASSIFICATION LAW: every srd521 domain type is an INDIVIDUAL
# with one fixed categoriae metatype. Domain classification uses
# cat:instanceOf; same-order specialization uses cat:specializes.
# No srd521 IRI is an rdfs:Class, and rdf:type is never used with
# an srd521 domain type as its object.
#################################################################

srd521:vocabulary
  a owl:Ontology ;
  dcterms:title "Dungeons & Dragons SRD 5.2.1 content vocabulary"@en ;
  dcterms:description "Edition-owned terms and curated content structures for the Dungeons & Dragons System Reference Document 5.2.1, expressed over the final Stagecraft vocabulary family."@en ;
  dcterms:source <https://media.dndbeyond.com/compendium-images/srd/5.2/SRD_CC_v5.2.1.pdf> ;
  dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
  dcterms:modified "2026-08-11"^^xsd:date .

#################################################################
# Controlled value families
#################################################################

srd521:AbilityScore
  a cat:Kind ;
  cat:instanceCategory cat:Individual ;
  rdfs:label "Ability score"@en ;
  rdfs:comment "The edition's controlled family of ability-score terms."@en .

srd521:Skill
  a cat:Kind ;
  cat:instanceCategory cat:Individual ;
  rdfs:label "Skill"@en ;
  rdfs:comment "The edition's controlled family of skill terms."@en .

srd521:DamageType
  a cat:Kind ;
  cat:instanceCategory cat:Individual ;
