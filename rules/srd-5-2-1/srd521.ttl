  rdfs:range xsd:integer ;
  rdfs:label "range distance in feet"@en .

srd521:rangeAreaText
  a rdf:Property ;
  cat:domainType srd521:SpellDefinition ;
  rdfs:range xsd:string ;
  rdfs:label "range area text"@en .

srd521:radiusFeet
  a rdf:Property ;
  cat:domainType srd521:AreaOfEffectShape ;
  rdfs:range xsd:integer ;
  rdfs:label "radius in feet"@en .

srd521:rangeFeet
  a rdf:Property ;
  cat:domainType srd521:AreaOfEffectShape ;
  rdfs:range xsd:integer ;
  rdfs:label "range in feet"@en ;
  rdfs:comment "NO LONGER A DIMENSION CARRIER for area shapes as of the 2026-07-27 F7 mints: it carried a cone's length and a CUBE'S EDGE, so an Alarm row published rangeFeet 20 for what is its cube size — a false RANGE assertion, not a missing column. Each shape kind now carries its own semantically named dimension (edgeFeet / lengthFeet / widthFeet / heightFeet / radiusFeet / diameterFeet). Retirement of this term is sequenced at F7 adoption, not here — srd-family.mjs still emits it."@en .

srd521:diameterFeet
  a rdf:Property ;
  cat:domainType srd521:AreaOfEffectShape ;
  rdfs:range xsd:integer ;
  rdfs:label "diameter in feet"@en ;
  rdfs:comment "MINTED 2026-07-27 (F7 area-shape dimensions; product ruling A1 on sc.task.2026-07-27_1416-area-shape-dimensions). A sphere row records the dimension THE SOURCE STATES: Flaming Sphere reads \"5-foot-diameter sphere\", and publishing that as radiusFeet 5 asserted a radius twice the truth. Exactly one of srd521:radiusFeet and srd521:diameterFeet is populated per sphere shape. Radius-from-diameter is a DECLARED DOWNSTREAM DERIVATION, never a silent conversion at extraction — converting destroys provenance and rewrites record identity."@en .

srd521:lengthFeet
  a rdf:Property ;
  cat:domainType srd521:AreaOfEffectShape ;
  rdfs:range xsd:integer ;
  rdfs:label "length in feet"@en ;
  rdfs:comment "MINTED 2026-07-27 (F7 area-shape dimensions): the long axis of a cone or line area, previously mis-carried in srd521:rangeFeet."@en .

srd521:widthFeet
  a rdf:Property ;
  cat:domainType srd521:AreaOfEffectShape ;
  rdfs:range xsd:integer ;
  rdfs:label "width in feet"@en ;
  rdfs:comment "MINTED 2026-07-27 (F7 area-shape dimensions): the cross axis of a line area. Lightning Bolt is 100 feet long by 5 feet wide; the width had no carrier at all and was dropped at extraction."@en .

srd521:heightFeet
  a rdf:Property ;
  cat:domainType srd521:AreaOfEffectShape ;
  rdfs:range xsd:integer ;
  rdfs:label "height in feet"@en ;
  rdfs:comment "MINTED 2026-07-27 (F7 area-shape dimensions): the vertical extent of a cylinder area. Ice Storm is a 20-foot-radius, 40-foot-high cylinder; the height had no carrier at all and was dropped at extraction."@en .

srd521:edgeFeet
  a rdf:Property ;
  cat:domainType srd521:AreaOfEffectShape ;
  rdfs:range xsd:integer ;
  rdfs:label "edge in feet"@en ;
  rdfs:comment "MINTED 2026-07-27 (F7 area-shape dimensions): the edge length of a cube area — the dimension whose absence produced the false-range class this mint closes."@en .

srd521:componentVerbal
  a rdf:Property ;
  cat:domainType srd521:SpellDefinition ;
  rdfs:range xsd:boolean ;
  rdfs:label "has verbal component"@en .

srd521:componentSomatic
  a rdf:Property ;
