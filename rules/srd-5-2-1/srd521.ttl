#################################################################
# Value-axis positions — this edition's cuts along the ruled axes
#
# The axes and the grammar are roleosum's (rol:ValueAxis,
# rol:ValueAxisPosition, rol:valueAxis, rol:valueAxisPosition,
# minted 2026-08-11 on Dave's ruling). The MEMBERS are edition
# content and are declared here, per amendment #9: the theory arm
# cannot tell lawful from chaotic without this rules system.
#
# Positions are AXIS-LOCAL. The two neutral positions are distinct
# IRIs sharing an English token: "neutral on ethics" and "neutral on
# morals" are different cuts, and collapsing them would make the
# term -> position -> axis join ambiguous.
#################################################################

## NEW MINT with no predecessor, minted 2026-08-11; ruled by Dave 2026-08-11 (product channel).
srd521:valueAxisPosition_ethicsLawful
  a cat:Individual ;
  cat:instanceOf rol:ValueAxisPosition ;
  rol:valueAxis rol:valueAxis_ethics ;
  cat:lexicalToken "lawful" ;
  rdfs:label "Lawful"@en ;
  rdfs:comment "The ethics-axis cut for a subject who honours order, rule and custom."@en .

## NEW MINT with no predecessor, minted 2026-08-11; ruled by Dave 2026-08-11 (product channel).
srd521:valueAxisPosition_ethicsNeutral
  a cat:Individual ;
  cat:instanceOf rol:ValueAxisPosition ;
  rol:valueAxis rol:valueAxis_ethics ;
  cat:lexicalToken "neutral" ;
  rdfs:label "Neutral (ethics)"@en ;
  rdfs:comment "The ethics-axis cut for a subject who is bound by neither order nor its rejection. Distinct from the morals-axis neutral position, which shares its token and not its identity."@en .

## NEW MINT with no predecessor, minted 2026-08-11; ruled by Dave 2026-08-11 (product channel).
srd521:valueAxisPosition_ethicsChaotic
  a cat:Individual ;
  cat:instanceOf rol:ValueAxisPosition ;
  rol:valueAxis rol:valueAxis_ethics ;
  cat:lexicalToken "chaotic" ;
  rdfs:label "Chaotic"@en ;
  rdfs:comment "The ethics-axis cut for a subject who follows personal impulse over order, rule and custom."@en .

## NEW MINT with no predecessor, minted 2026-08-11; ruled by Dave 2026-08-11 (product channel).
srd521:valueAxisPosition_moralsGood
  a cat:Individual ;
  cat:instanceOf rol:ValueAxisPosition ;
  rol:valueAxis rol:valueAxis_morals ;
  cat:lexicalToken "good" ;
  rdfs:label "Good"@en ;
  rdfs:comment "The morals-axis cut for a subject who acts for the welfare of others."@en .

## NEW MINT with no predecessor, minted 2026-08-11; ruled by Dave 2026-08-11 (product channel).
srd521:valueAxisPosition_moralsNeutral
  a cat:Individual ;
  cat:instanceOf rol:ValueAxisPosition ;
  rol:valueAxis rol:valueAxis_morals ;
  cat:lexicalToken "neutral" ;
  rdfs:label "Neutral (morals)"@en ;
  rdfs:comment "The morals-axis cut for a subject who is moved by neither the welfare of others nor its opposite. Distinct from the ethics-axis neutral position, which shares its token and not its identity."@en .

## NEW MINT with no predecessor, minted 2026-08-11; ruled by Dave 2026-08-11 (product channel).
srd521:valueAxisPosition_moralsEvil
  a cat:Individual ;
  cat:instanceOf rol:ValueAxisPosition ;
  rol:valueAxis rol:valueAxis_morals ;
  cat:lexicalToken "evil" ;
  rdfs:label "Evil"@en ;
  rdfs:comment "The morals-axis cut for a subject who acts against the welfare of others."@en .

#################################################################
# The alignment scheme — this edition's rol:ValueScheme
#################################################################

## NEW MINT with no predecessor; CARD AV (e) (Dave, 2026-08-15), scheme-owned occupancy policy
##   ruled by Dave 2026-08-16 ("(b) Scheme-owned policy"). Instance idiom per d20-test.ttl
##   (a cat:Description; cat:instanceOf <Kind>).
srd521:alignmentScheme
  a cat:Description ;
  cat:instanceOf rol:ValueScheme ;
  rol:schemeTermType srd521:AlignmentTerm ;
  rol:valueSchemeAxisRule srd521:alignmentEthicsAxisRule, srd521:alignmentMoralsAxisRule ;
  rol:occupancyRule rol:occupancyRule_allRequiredOrNone ;
  rdfs:label "SRD 5.2.1 alignment scheme"@en ;
  rdfs:comment "This edition's value scheme for alignment: the ethics and morals axes, both required, under the all-required-axes-or-none occupancy rule. Nine graded terms occupy both axes; unaligned is positively off-grid. The axes are roleosum's reusable stock; which of them this edition uses, and on what terms, is stated here and nowhere else."@en .

## NEW MINT with no predecessor; the (scheme, ethics) rule row.
srd521:alignmentEthicsAxisRule
  a cat:Description ;
  cat:instanceOf rol:ValueSchemeAxisRule ;
  rol:governedValueAxis rol:valueAxis_ethics ;
  rol:axisRequirement rol:axisRequirement_required ;
  rdfs:label "SRD alignment ethics-axis rule"@en .

## NEW MINT with no predecessor; the (scheme, morals) rule row.
srd521:alignmentMoralsAxisRule
  a cat:Description ;
  cat:instanceOf rol:ValueSchemeAxisRule ;
  rol:governedValueAxis rol:valueAxis_morals ;
  rol:axisRequirement rol:axisRequirement_required ;
  rdfs:label "SRD alignment morals-axis rule"@en .

## NEW MINT with no predecessor, minted 2026-08-11; ruled by Dave 2026-08-11 (product channel).
## SPECIALIZES rol:OffGridValueSchemeTerm 2026-08-16 (with the scheme mint): the generic no-position
##   marker is theory's, so the general occupancy shape names no edition IRI; this class keeps its
##   landed name and its parent, and gains the theory edge.
srd521:OffAxisAlignmentTerm
  a cat:Kind ;
  cat:specializes srd521:AlignmentTerm, rol:OffGridValueSchemeTerm ;
  cat:instanceCategory cat:Individual ;
  rdfs:label "Off-axis alignment term"@en ;
  rdfs:comment "An alignment term that sits off the two-axis grid rather than at a cell of it, and therefore carries no rol:valueAxisPosition. Being off the grid is asserted here positively rather than inferred from a missing edge, so a reader can tell it apart from a term whose positions merely have not been recorded. Under srd521:alignmentScheme's all-required-axes-or-none occupancy rule this is the second lawful case, never an exception."@en ;
  rdfs:seeAlso rol:OffGridValueSchemeTerm, rol:valueAxisPosition .

