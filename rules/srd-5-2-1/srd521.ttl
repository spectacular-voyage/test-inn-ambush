srd521:SpellSchool
  a cat:Kind ;
  cat:instanceCategory cat:Individual ;
  rdfs:label "Spell school"@en ;
  rdfs:comment "A school of magic as the SRD 5.2.1 edition names it, used to classify spells. It is a reusable rules-data concept, not anything a spell or caster does in play."@en .

srd521:ConditionEffectType
