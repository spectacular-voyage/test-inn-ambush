srd521:d20-test dcterms:source <https://media.dndbeyond.com/compendium-images/srd/5.2/SRD_CC_v5.2.1.pdf>;
    dcterms:title "SRD 5.2.1 D20 test rules"@en;
    a dcat:Dataset.
<https://stagecraft.github.io/srd-rules/srd-5-2-1/d20-test/d20-test-warranted-precondition-ask> cat:instanceOf par:SparqlAskPrecondition;
    a cat:InformationObject;
    rdf:value "ASK { # Authority or a rule has warranted a D20 Test in the current circumstance. }";
    rdfs:comment "RESTORED under DF-RESTORE-1/DF-CRUFT-2. The family regeneration DISSOLVED this individual and FLATTENED its rdf:value onto the dcterms:description of the D20 test types that referenced it. Verbatim from srd-rules 56aad03262a2 srd-5-2-1/d20-test/d20-test.ttl:43-45. NOTE: the frozen v2 row for dyn:D20TestWarrantedPreconditionAsk carries an EMPTY target, so the class here follows the conditions.ttl precedent (par:SparqlAskPrecondition) rather than a mapped target.".

<https://stagecraft.github.io/srd-rules/srd-5-2-1/d20-test/d20-roll-result-template> cat:instanceOf srd521:D20TestConsequence;
    a cat:Description;
    rdf:value "Roll 1d20, apply the relevant ability modifier, proficiency if applicable, and circumstantial modifiers, then compare against the target number.";
    rdfs:comment "RESTORED under DF-RESTORE-1/DF-CRUFT-2, same dissolution as the precondition ask above. Verbatim from srd-rules 56aad03262a2 srd-5-2-1/d20-test/d20-test.ttl:47-49; class from the frozen row's own target (srd521:D20TestConsequence).".

<https://stagecraft.github.io/srd-rules/srd-5-2-1/d20-test/ability-check> dcterms:description "A creature uses talent and training to try to overcome a challenge when the outcome is uncertain and meaningful.";
    par:preconditionAsk <https://stagecraft.github.io/srd-rules/srd-5-2-1/d20-test/d20-test-warranted-precondition-ask>;
    par:consequenceTemplate <https://stagecraft.github.io/srd-rules/srd-5-2-1/d20-test/d20-roll-result-template>;
    dcterms:isPartOf srd521:d20-test;
    cat:instanceOf par:ActionType;
    a cat:EventType;
    cat:instanceCategory cat:Action;
    par:rollProcedure srd521:D20RollProcedure;
    cat:instanceOf srd521:D20TestType;
    cat:specializes srd521:D20Test;
    rdfs:comment "The SRD 5.2.1 ability check rules term.";
    rdfs:label "Ability check";
    cat:lexicalToken "ability-check";
    srd521:mechanicalStatus <https://stagecraft.github.io/srd-rules/srd-5-2-1/mechanical-statuses/actiontype-family>;
    srd521:sourceSection "Playing the Game: Ability Checks";
    srd521:targetNumberName "Difficulty Class".
