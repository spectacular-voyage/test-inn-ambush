@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix dcat: <http://www.w3.org/ns/dcat#>.
@prefix cat: <https://categoriae.github.io/ontology/>.
@prefix kosm: <https://kosmion.github.io/ontology/>.
@prefix par: <https://participatorium.github.io/ontology/>.
@prefix srd521: <https://stagecraft.github.io/srd-rules/srd-5-2-1/>.

srd521:healing-kinds dcterms:source <https://media.dndbeyond.com/compendium-images/srd/5.2/SRD_CC_v5.2.1.pdf>;
    dcterms:title "SRD 5.2.1 healing-kinds"@en;
    a dcat:Dataset.
<https://stagecraft.github.io/srd-rules/srd-5-2-1/healing-kinds/hit-point-maximum> cat:instanceOf srd521:HealingKind;
    a cat:Individual;
    rdfs:comment "The SRD 5.2.1 healing kind Hit point maximum.";
    rdfs:label "Hit point maximum"@en;
    cat:lexicalToken "hit-point-maximum".
<https://stagecraft.github.io/srd-rules/srd-5-2-1/healing-kinds/hit-points> cat:instanceOf srd521:HealingKind;
    a cat:Individual;
    rdfs:comment "The SRD 5.2.1 healing kind Hit points.";
    rdfs:label "Hit points"@en;
    cat:lexicalToken "hit-points".
<https://stagecraft.github.io/srd-rules/srd-5-2-1/healing-kinds/temporary-hit-points> cat:instanceOf srd521:HealingKind;
    a cat:Individual;
    rdfs:comment "The SRD 5.2.1 healing kind Temporary hit points.";
    rdfs:label "Temporary hit points"@en;
    cat:lexicalToken "temporary-hit-points".
