srd521:skills dcterms:source <https://media.dndbeyond.com/compendium-images/srd/5.2/SRD_CC_v5.2.1.pdf>;
    dcterms:title "SRD 5.2.1 skills"@en;
    a dcat:Dataset.
<https://stagecraft.github.io/srd-rules/srd-5-2-1/skills/acrobatics> dcterms:isPartOf srd521:d20-test;
    cat:instanceOf srd521:Skill;
    a cat:Individual;
    rdfs:comment "The SRD 5.2.1 skill named Acrobatics.";
    rdfs:label "Acrobatics"@en;
    cat:lexicalToken "acrobatics";
    srd521:defaultAbility <https://stagecraft.github.io/srd-rules/srd-5-2-1/abilities/dexterity>;
    srd521:exampleUses "Stay on your feet in a tricky situation, or perform an acrobatic stunt.";
    srd521:sourceSection "Playing the Game: Skills".
