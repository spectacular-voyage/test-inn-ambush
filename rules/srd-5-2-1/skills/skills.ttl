    srd521:defaultAbility <https://stagecraft.github.io/srd-rules/srd-5-2-1/abilities/wisdom>;
    srd521:exampleUses "Calm or train an animal, or get an animal to behave in a certain way.";
    srd521:sourceSection "Playing the Game: Skills".
